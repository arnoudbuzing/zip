 DefaultNewCellStyle->"Notes",
 CellTags->{"Details", "TemplateCellGroup"},
 CellID->280804237,ExpressionUUID->"99d3c7d1-5353-4442-ac57-1c690c0f0252"],

Cell[TextData[{
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["Zip", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ArnoudBuzing/ZipLink/ref/Zip",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "740ea7ab-1f2f-4985-bbd9-9bf31327068d"],
 " supports ",
 Cell[BoxData["\"\<Deflate\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "832279e6-ef65-4cda-94fd-4d7b328b8247"],
 ", ",
 Cell[BoxData["\"\<Bzip2\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e7fe927c-ef38-461d-ac1a-7cd984556e34"],
 ", and ",
 Cell[BoxData["\"\<ZStandard\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d5e0b9df-db7a-4c60-b599-112c1bdfb4ef"],
 " (zstd) compression options."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.9833530269294662`*^9, 3.983353079305112*^9}, {
  3.983353190117509*^9, 3.9833532029056387`*^9}, {3.9833533087964163`*^9, 
