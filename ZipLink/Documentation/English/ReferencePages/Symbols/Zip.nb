  StyleBox["source", "TI"]], "InlineFormula",ExpressionUUID->
  "48b9af01-a26f-404d-948e-78d936ca9d40"],
 " file or directory and saves it to ",
 Cell[BoxData[
  StyleBox["dest", "TI"]], "InlineFormula",ExpressionUUID->
  "7c10ca38-3bcf-4f78-b670-6f3646d77e3f"],
 "."
}], "Usage",
 CellChangeTimes->{{3.983356199653068*^9, 3.983356249882102*^9}},
 CellID->897663329,ExpressionUUID->"d5384c74-5d4f-47e7-bd3c-43c151170646"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["source", "TI"]], "InlineFormula",ExpressionUUID->
  "d41cd5ab-c9ab-4c3e-a978-3b4ca2cdd6ab"],
 " argument can be a file or directory."
}], "Notes",
 CellChangeTimes->{{3.983356365827133*^9, 3.983356390114667*^9}},
 CellID->954950328,ExpressionUUID->"3e373917-2312-43e0-b034-8b47f6a44f11"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["Zip",
   BaseStyle->"Link",
   ButtonData->"paclet:ArnoudBuzing/ZipLink/ref/Zip"]], "InlineFormula",
  ExpressionUUID->"9dc21764-8fdd-446f-97e1-45f9d5183982"],
 " takes two options: ",
 Cell[BoxData[
  ButtonBox["ZipMethod",
   BaseStyle->"Link",
   ButtonData->"paclet:ArnoudBuzing/ZipLink/ref/CompressionMethod"]], 
  "InlineFormula",ExpressionUUID->"68694536-6d74-48a0-a0ad-d647286694fe"],
