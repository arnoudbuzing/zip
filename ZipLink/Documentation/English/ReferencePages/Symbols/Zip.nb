    ButtonData->"paclet:ArnoudBuzing/ZipLink/ref/Zip"], "[", 
   RowBox[{
    StyleBox["source", "TI"], ",", 
    StyleBox["dest", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c2e91338-ab99-4c65-9b85-480b0b566a48"],
