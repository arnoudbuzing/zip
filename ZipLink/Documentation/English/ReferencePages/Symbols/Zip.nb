 Cell[BoxData[
  ButtonBox["ZipLevel",
   BaseStyle->"Link",
   ButtonData->"paclet:ArnoudBuzing/ZipLink/ref/CompressionLevel"]], 
  "InlineFormula",ExpressionUUID->"0add3909-058d-4b06-b014-4ed55bfdcdcc"],
 "."
}], "Notes",
 CellChangeTimes->{{3.983356404771564*^9, 3.9833565821261663`*^9}, {
  3.983359530162822*^9, 3.9833595356076927`*^9}},
 CellID->1931766838,ExpressionUUID->"8b1e5513-8e3a-48f8-8af7-f77268171e74"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["CompressionMethod",
   BaseStyle->"Link",
   ButtonData->"paclet:ArnoudBuzing/ZipLink/ref/CompressionMethod"]], 
  "InlineFormula",ExpressionUUID->"52ee4837-47e4-4ee2-9665-b8f7a72341c6"],
 " can be any of the following:"
}], "Notes",
 CellChangeTimes->{{3.9833568641373873`*^9, 3.9833568803908997`*^9}},
 CellID->1516879942,ExpressionUUID->"a5360849-6666-423a-8cd6-3867886bede8"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c73c1d51-39c5-4389-b696-a412b25de0e7"], "\"\<ZStandard\>\"", Cell[
    "fast zip compression", "TableText",ExpressionUUID->
     "a4f41696-ffcb-4df4-9f0f-cb6d37b369c3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "aed0071c-6c7a-42b4-8967-cc388e9d9ed3"], "\"\<Deflate\>\"", Cell[
    "standard zip compression", "TableText",ExpressionUUID->
     "ba64a56c-9c96-4112-9c41-32211b8a2237"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6f92e8a1-77a8-48b6-afa0-8567d06cf55c"], "\"\<Bzip2\>\"", Cell[
    "bzip compression", "TableText",ExpressionUUID->
     "a895be00-62e1-4c37-b502-92a59487f3ae"]}
  }]], "2ColumnTableMod",
 CellChangeTimes->{{3.98335672720287*^9, 3.9833567314819803`*^9}, {
  3.9833567823914223`*^9, 3.983356835501527*^9}},
 CellID->407598669,ExpressionUUID->"e7456431-fd39-45ee-bc5b-52cbafb2071c"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["CompressionLevel",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "6839935c-b1da-4765-aa58-137d033a3357"],
 " ranges from -7 (least) to 22 (most) for ",
 Cell[BoxData["\"\<ZStandard\>\""], "InlineFormula",ExpressionUUID->
  "f102b449-1b23-4c5a-8c0a-ba4eef2e67e2"],
 " with a default of 3. For ",
 Cell[BoxData["\"\<Deflate\>\""], "InlineFormula",ExpressionUUID->
  "8542bcde-78fa-4187-8e8d-9407e0b36a43"],
 " and ",
 Cell[BoxData["\"\<Bzip2\>\""], "InlineFormula",ExpressionUUID->
  "b916d617-dd0d-4a9c-8013-4adafe4d5e66"],
 " the levels range from 0 (least) to 9 (most) with a default of 6."
}], "Notes",
 CellChangeTimes->{{3.983356882603492*^9, 3.9833570053278837`*^9}},
 CellID->2093432111,ExpressionUUID->"3eb90d2a-dcaa-4370-828f-fdf321814a39"]
